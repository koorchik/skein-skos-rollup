node_modules/
.env

# Run artifacts are committed IN FULL — run-card.json, registry.json, schema.json,
# decisions.jsonl, artifacts/, extractions/, graph/, run-view.html AND llm-calls/ transcripts:
# this repo holds the paper's purposeful experiment set, not a call history (author decision
# 2026-08-23). Only the embeddings cache stays out (reproducible, keyed (provider, model, text)).
runs/embeddings-cache/
runs/**/embeddings-cache/

# scratch
*.log
.DS_Store
site/
CLAUDE.md

# Python sidecar (analysis/hyperbolic): venv and generated exchange files stay out; the environment
# record and the smoke transcript are committed because reported numbers cite them.
analysis/hyperbolic/.venv/
analysis/hyperbolic/__pycache__/
analysis/hyperbolic/in/
analysis/hyperbolic/out/*
!analysis/hyperbolic/out/env.json
!analysis/hyperbolic/out/smoke.txt
